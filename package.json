{
  "name": "quester",
  "version": "2.5.2",
  "description": "答题，刷题，考试，AI生题，AI判题",
  "main": "main.js",
  "productName": "Quester",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build:vue": "cd frontend && npm run build",
    "rebuild": "electron-rebuild -f",
    "build:win": "npm run build:vue && electron-builder --win --x64",
    "build:msix": "npm run build:vue && electron-builder --win --x64 --config.win.target=appx"
  },
  "build": {
    "appId": "com.ispace.quester",
    "directories": {
      "output": "release/"
    },
    "files": [
      "**/*",
      "!frontend/",
      "frontend/dist/**/*",
      "!node.exe",
      "!models/",
      "!scripts/installer.nsh"
    ],
    "win": {
      "target": "nsis",
      "icon": "frontend/public/favicon1.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "artifactName": "Quester-Setup-${version}.${ext}",
      "shortcutName": "Quester"
    },
    "appx": {
      "applicationId": "Quester",
      "backgroundColor": "#1c1c1e",
      "displayName": "Quester",
      "publisherDisplayName": "ispace王",
      "publisher": "CN=4499F0C4-83E9-49C6-B136-A9BA2D5FCE8F",
      "identityName": "20029ispace.3399075889352",
      "showNameOnTiles": true,
      "setBuildNumber": false
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.1.2",
    "cors": "^2.8.5",
    "driver.js": "^1.3.6",
    "electron-store": "^10.1.0",
    "express": "^4.19.2",
    "katex": "^0.16.0",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "async-validator": "^4.2.5",
    "axios": "^1.7.2",
    "chart.js": "^4.4.3",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.12",
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "element-plus": "^2.7.7",
    "lodash": "^4.17.21",
    "rxjs": "^7.8.1",
    "sass-embedded": "^1.77.8",
    "vite": "^5.3.5",
    "vue": "^3.4.34",
    "vue-chartjs": "^5.3.1"
  },
  "author": "",
  "license": "ISC"
}
