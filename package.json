{
  "name": "quesora",
  "version": "2.5.6",
  "description": "答题，刷题，考试，AI生题，AI判题",
  "main": "main.js",
  "productName": "Quesora",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build:vue": "cd frontend && npm run build",
    "rebuild": "electron-rebuild -f",
    "build:win": "npm run build:vue && electron-builder --win --x64",
    "build:msix": "npm run build:vue && electron-builder --win --x64 --config.win.target=appx"
  },
  "build": {
    "appId": "com.ispace.quesora",
    "icon": "frontend/public/icon-512x512.png",
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "directories": {
      "output": "release/"
    },
    "files": [
      "**/*",
      "!frontend/",
      "frontend/dist/**/*",
      "!frontend/dist/quesora-banner*.png",
      "!frontend/dist/quesora banner.png",
      "!frontend/dist/icon.jpg",
      "!frontend/dist/icon.png",
      "!frontend/dist/vite.svg",
      "!frontend/dist/question.webp",
      "!node.exe",
      "!models/",
      "!scripts/installer.nsh",
      "!backend/uploads/*",
      "!backend/quiz.db",
      "!backend/database/*.db",
      "!backend/node_modules/",
      "!generate_tiles.py",
      "!patch_appx_manifest.py",
      "!test-cert.pfx",
      "!MSIX-GUIDE.md",
      "!CHANGELOG.md"
    ],
    "win": {
      "target":  ["nsis", "appx"],
      "icon": "frontend/public/icon-512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "artifactName": "Quesora-Setup-${version}.${ext}",
      "shortcutName": "Quesora"
    },
    "appx": {
      "applicationId": "Quesora",
      "backgroundColor": "#1c1c1e",
      "displayName": "Quesora",
      "publisherDisplayName": "ispace王",
      "publisher": "CN=4499F0C4-83E9-49C6-B136-A9BA2D5FCE8F",
      "identityName": "20029ispace.Quesora",
      "showNameOnTiles": true,
      "setBuildNumber": false
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.1.2",
    "cors": "^2.8.5",
    "driver.js": "^1.3.6",
    "electron-store": "^10.1.0",
    "express": "^4.19.2",
    "katex": "^0.16.0",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "async-validator": "^4.2.5",
    "axios": "^1.7.2",
    "chart.js": "^4.4.3",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.12",
    "electron": "^36.0.1",
    "electron-builder": "^25.1.8",
    "@electron/rebuild": "^3.6.1",
    "element-plus": "^2.7.7",
    "lodash": "^4.17.21",
    "rxjs": "^7.8.1",
    "sass-embedded": "^1.77.8",
    "vite": "^5.3.5",
    "vue": "^3.4.34",
    "vue-chartjs": "^5.3.1"
  },
  "author": "",
  "license": "ISC"
}
